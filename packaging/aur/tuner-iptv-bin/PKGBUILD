# Maintainer: Tuner IPTV
#
# Prebuilt release binaries. Regenerate .SRCINFO after editing:
#   makepkg --printsrcinfo > .SRCINFO
# See docs/packaging.md.

pkgname=tuner-iptv-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Lean, Linux-native IPTV player written in Rust (terminal and GTK4), powered by mpv'
arch=('x86_64')
url='https://github.com/tuner-iptv/Tuner'
license=('GPL-3.0-or-later')
depends=('mpv' 'gtk4' 'glibc' 'gcc-libs')
provides=('tuner-iptv')
# The AUR radio player also installs /usr/bin/tuner.
conflicts=('tuner-iptv' 'tuner-iptv-git' 'tuner' 'tuner-git')
source=("$url/releases/download/v$pkgver/tuner-v$pkgver-x86_64-linux.tar.gz")
sha256sums=('26af9012c9ba41b85ec4687b2dda48280094a98182e8c28d49a63474d3e8b813')
options=('!debug')

package() {
  cd "tuner-v$pkgver-x86_64-linux"
  install -Dm755 tuner "$pkgdir/usr/bin/tuner"
  install -Dm755 tuner-gtk "$pkgdir/usr/bin/tuner-gtk"
  install -Dm644 tuner-gtk.desktop "$pkgdir/usr/share/applications/tuner-gtk.desktop"
  install -Dm644 io.github.tuner_iptv.Tuner.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.tuner_iptv.Tuner.svg"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
